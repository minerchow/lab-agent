# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lab_agent

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 环境标识
ENV=development

# JWT 配置
JWT_SECRET_KEY=fastapiapp-dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM 配置
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

# 向量库配置（硅基流动 BAAI/bge-m3，API Key 在 https://cloud.siliconflow.cn 获取，留空则回退本地模型）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# 知识库检索配置
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=50
KB_SYNC_INTERVAL=60
KB_QUERY_PREFIX_ENABLED=true
KB_SEARCH_TOP_K=5
KB_FINAL_TOP_K=2
KB_SCORE_THRESHOLD=0.5
